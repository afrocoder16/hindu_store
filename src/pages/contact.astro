---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../assets/illustrations/contact.svg';
import clock from '../assets/icons/clock.png';
import email from '../assets/icons/email.png';
import map from '../assets/icons/map.png';
import phone from '../assets/icons/phone.png';
import { site } from '../config';

const channel = site.whatsapp ? 'whatsapp' : site.email ? 'email' : 'copy';
const buttonLabel = { whatsapp: 'Send on WhatsApp', email: 'Send by email', copy: 'Copy message' }[channel];
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}`}>
  <div class="wrap">
    <div class="page-head">
      <span class="eyebrow">Contact</span>
      <h1>Say hello</h1>
      <p>Questions, catering or feedback? Send us a message.</p>
    </div>

    <div class="info-grid" style="margin-bottom:2rem">
      <div class="info">
        <h3><Image src={clock} alt="" width={24} height={24} />Opening hours</h3>
        <p>Daily, {site.hours}</p>
      </div>
      {site.phone && (
        <div class="info">
          <h3><Image src={phone} alt="" width={24} height={24} />Phone</h3>
          <p><a href={`tel:${site.phone}`}>{site.phone}</a></p>
        </div>
      )}
      {site.email && (
        <div class="info">
          <h3><Image src={email} alt="" width={24} height={24} />Email</h3>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      )}
      {site.address && (
        <div class="info">
          <h3><Image src={map} alt="" width={24} height={24} />Address</h3>
          <p>{site.address}</p>
        </div>
      )}
    </div>

    <section class="split" style="padding-bottom:3rem">
      <Image src={contact} alt="" width={560} height={420} />
      <form id="contact-form" class="form panel" data-channel={channel} data-whatsapp={site.whatsapp} data-email={site.email} data-site={site.name}>
        <div class="field">
          <label for="c-name">Name</label>
          <input id="c-name" name="name" autocomplete="name" required maxlength="60" />
        </div>
        <div class="field">
          <label for="c-phone">Phone or email</label>
          <input id="c-phone" name="reach" autocomplete="email" required maxlength="80" />
        </div>
        <div class="field">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" required maxlength="500"></textarea>
        </div>
        <button class="btn" type="submit">{buttonLabel}</button>
        {channel === 'copy' && <p class="note">Messaging isn't connected yet, so this copies your message to paste to us.</p>}
        <p class="note" id="contact-status" role="status"></p>
      </form>
    </section>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form')!;
    const status = document.querySelector<HTMLElement>('#contact-status')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const text = `Message for ${form.dataset.site}\n\nName: ${d.get('name')}\nContact: ${d.get('reach')}\n\n${d.get('message')}`;

      if (form.dataset.channel === 'whatsapp') {
        window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
        status.textContent = 'WhatsApp opened with your message. Send it to finish.';
      } else if (form.dataset.channel === 'email') {
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Message from the website')}&body=${encodeURIComponent(text)}`;
        status.textContent = 'Your email app opened with your message. Send it to finish.';
      } else {
        try {
          await navigator.clipboard.writeText(text);
          status.textContent = 'Message copied.';
        } catch {
          status.textContent = 'Could not copy automatically.';
        }
      }
    });
  </script>
</BaseLayout>
