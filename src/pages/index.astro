---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuSection from '../components/MenuSection.astro';
import { products } from '../data/products';
import { site } from '../config';
import { formatPrice } from '../lib/format';
import { OPEN_MIN, CLOSE_MIN, formatClock } from '../lib/hours';
import storefront from '../assets/store/storefront.webp';
import ahmed from '../assets/store/ahmed-omar.webp';

const special = products.find((p) => p.id === site.special.productId)!;
const specialThumb = await getImage({ src: special.image, width: 144, height: 144, format: 'webp' });
const tickerItems =[...products.map((p) => p.name)];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Marshall, Minnesota</span>
        <h1 id="hero-title">Quality foods. <em>Warm welcome.</em> Always fresh.</h1>
        <p class="lead">
          A family-run grocery and deli in downtown Marshall. Order your favorites online for pickup or dine-in, or just come on in.
        </p>
        <div class="hero-actions">
          <a class="btn btn-orange" href="/#menu">Order online</a>
          <a class="btn btn-light" href={`tel:${site.phone}`}>Call us</a>
        </div>
      </div>
      <div class="hero-photo">
        <Image src={storefront} alt="The Hindi Store storefront on Main Street with its orange brick wall and green OPEN sign" widths={[480, 720, 960]} sizes="(min-width: 900px) 440px, 90vw" loading="eager" />
        <span class="hero-tag">Groceries &middot; Deli &middot; Dine-in &middot; Carry-out</span>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => tickerItems.map((name) => <span>{name}</span>))}
    </div>
  </div>

  <section class="section" id="special" aria-labelledby="special-title">
    <div class="wrap">
      <div class="special">
        <div class="special-img">
          <Image src={special.image} alt={special.name} widths={[480, 720, 1000]} sizes="(min-width: 860px) 560px, 100vw" loading="lazy" />
        </div>
        <div class="special-body">
          <span class="eyebrow">{site.special.label}</span>
          <h2 id="special-title">{site.special.title}</h2>
          <p class="muted">{site.special.text}</p>
          <div class="special-price">{formatPrice(special.price, site.currency)}</div>
          <div class="btn-row">
            <button
              class="btn"
              type="button"
              data-add
              data-id={special.id}
              data-name={special.name}
              data-price={special.price}
              data-image={specialThumb.src}
            >
              Add to cart
            </button>
            <a class="btn btn-ghost" href={`/product/${special.id}/`}>Details</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <MenuSection />

  <section class="section story" id="story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <figure style="margin:0">
        <div class="story-photo">
          <Image src={ahmed} alt="Ahmed Omar, owner of Hindi Store, standing beside the store's drink and frozen food coolers" widths={[480, 720, 1000]} sizes="(min-width: 860px) 520px, 100vw" loading="lazy" />
        </div>
        <figcaption class="caption">Ahmed Omar, owner</figcaption>
      </figure>
      <div>
        <span class="eyebrow">Our story</span>
        <h2 id="story-title">A family store, <em>right on Main Street</em></h2>
        <!-- TODO: draft copy. Have Ahmed Omar review and edit before launch. -->
        <p>
          Hindi Store is a family-run grocery and deli in downtown Marshall, owned by Ahmed Omar. Stop in for groceries and
          cultural foods that are hard to find elsewhere in town, and for hot plates from the deli counter.
        </p>
        <p>Dine in or carry out, whichever suits your day.</p>
        <ul class="highlights">
          <li><strong>Quality cultural foods</strong>Groceries and ingredients you can't easily find elsewhere.</li>
          <li><strong>Made at the deli counter</strong>Dine-in or carry-out, cooked fresh.</li>
          <li><strong>A neighborhood welcome</strong>Family-run and part of Marshall's community.</li>
        </ul>
        <div class="btn-row" style="margin-top:1.6rem">
          <a class="btn btn-orange" href="/#visit">Come see us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="visit" aria-labelledby="visit-title">
    <div class="wrap visit-grid">
      <div>
        <span class="eyebrow">Visit</span>
        <h2 id="visit-title">Come on <em>in</em></h2>
        <p class="muted">The entrance is on the side of the building. Look for the orange wall and the green OPEN sign.</p>
        <ul class="info-list">
          <li><strong>Hours</strong>Open daily, {formatClock(OPEN_MIN)} to {formatClock(CLOSE_MIN)}</li>
          <li><strong>Address</strong>{site.address}</li>
          <li><strong>Phone</strong><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>
          {site.email && <li><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        </ul>
        <div class="btn-row">
          <a class="btn" href={site.directionsUrl} target="_blank" rel="noopener">Get directions</a>
          <a class="btn btn-ghost" href={`tel:${site.phone}`}>Call us</a>
        </div>
      </div>
      <div class="visit-photo">
        <Image src={storefront} alt="Front door of Hindi Store with the sign reading Groceries and Deli, Dine-in, Carry-out" widths={[480, 720, 960]} sizes="(min-width: 860px) 540px, 100vw" loading="lazy" />
      </div>
    </div>
  </section>
</BaseLayout>
