---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../assets/illustrations/about.svg';
import { site } from '../config';
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <div class="wrap">
    <div class="page-head">
      <span class="eyebrow">About us</span>
      <h1>Food made the way it should be.</h1>
    </div>

    <section class="section split" style="padding-top:1rem">
      <Image src={about} alt="" width={560} height={420} />
      <div>
        <h2>Why choose us?</h2>
        <!-- TODO: replace with the owner's real story. The old site only had placeholder text here. -->
        <p>
          At {site.name} we cook every dish fresh, from hearty rice plates to crisp sambusa, cool drinks and sweet
          treats to finish.
        </p>
        <p>Browse the menu, add what you like to your cart and send us your order. We take it from there.</p>
        <a class="btn" href="/menu/">Our menu</a>
      </div>
    </section>

    <section class="section" aria-labelledby="steps-title">
      <div class="section-head"><h2 id="steps-title">Simple steps</h2></div>
      <div class="steps">
        <div class="step"><h3>Choose your food</h3><p>Pick from dishes, snacks, drinks and desserts.</p></div>
        <div class="step"><h3>Send your order</h3><p>Fill in your details and send the order to us.</p></div>
        <div class="step"><h3>Enjoy</h3><p>Fresh food, ready when you are.</p></div>
      </div>
    </section>
  </div>
</BaseLayout>
