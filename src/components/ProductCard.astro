---
import { Image, getImage } from 'astro:assets';
import type { Product } from '../data/products';
import { categories } from '../data/categories';
import { site } from '../config';
import { formatPrice } from '../lib/format';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const categoryName = categories.find((c) => c.id === product.category)?.name;
const thumb = await getImage({ src: product.image, width: 144, height: 144, format: 'webp' });
const href = `/product/${product.id}/`;
const searchText = `${product.name} ${product.description} ${categoryName}`.toLowerCase();
---

<article class="card" data-card data-search={searchText}>
  <a class="card-media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={product.image}
      alt=""
      widths={[320, 480, 720]}
      sizes="(min-width: 1100px) 280px, (min-width: 760px) 30vw, 46vw"
      loading="lazy"
    />
    <span class="card-cat">{categoryName}</span>
    <span class="card-price">{formatPrice(product.price, site.currency)}</span>
  </a>
  <div class="card-body">
    <h3><a href={href}>{product.name}</a></h3>
    <p class="card-desc">{product.description}</p>
    <div class="add-area" data-add-area data-id={product.id}>
      <button
        class="btn btn-small btn-gold"
        type="button"
        data-add
        data-id={product.id}
        data-name={product.name}
        data-price={product.price}
        data-image={thumb.src}
        aria-label={`Add ${product.name} to your order`}
      >
        Add to order
      </button>
      <div class="stepper" data-stepper hidden>
        <button type="button" data-step="-1" data-id={product.id} aria-label={`Remove one ${product.name}`}>&minus;</button>
        <span data-qty aria-live="polite">1</span>
        <button type="button" data-step="1" data-id={product.id} aria-label={`Add one more ${product.name}`}>+</button>
      </div>
    </div>
  </div>
</article>
