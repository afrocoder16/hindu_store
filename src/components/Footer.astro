---
import { site } from '../config';
import { OPEN_MIN, CLOSE_MIN, formatClock } from '../lib/hours';

const year = new Date().getFullYear();
const social = [
  { label: 'Instagram', url: site.social.instagram, icon: 'instagram' },
  { label: 'Facebook', url: site.social.facebook, icon: 'facebook' },
  { label: 'TikTok', url: site.social.tiktok, icon: 'tiktok' },
].filter((s) => s.url);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-lead">Quality cultural <span class="script" style="color:var(--gold);font-size:1.15em;text-transform:none">foods</span></div>
        <p style="color:var(--muted-dark);max-width:26rem">
          {site.name} is a family-run grocery and deli in downtown Marshall. Dine in, carry out, or text your order ahead.
        </p>
        <a class="btn btn-gold btn-small" href={`sms:${site.smsNumber}`}>Text {site.smsDisplay}</a>
        {social.length > 0 && (
          <ul class="social" aria-label="Follow us">
            {social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {s.icon === 'instagram' && (
                      <>
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
                      </>
                    )}
                    {s.icon === 'facebook' && <path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5v4h3v7h4v-7h3l1-4h-4V7.5c0-.3.2-.5.5-.5H15z" />}
                    {s.icon === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.3 2.4 1.9 4.2 4.5 4.5" />}
                  </svg>
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <div>
        <h3>Explore</h3>
        <ul>
          <li><a href="/#special">This week's plate</a></li>
          <li><a href="/#menu">Menu</a></li>
          <li><a href="/#how">How to order</a></li>
          <li><a href="/#catering">Catering &amp; events</a></li>
          <li><a href="/#reviews">Reviews</a></li>
          <li><a href="/#story">Our story</a></li>
          <li><a href="/#visit">Visit</a></li>
        </ul>
      </div>
      <div>
        <h3>Visit</h3>
        <ul>
          <li>Open daily, {formatClock(OPEN_MIN)} to {formatClock(CLOSE_MIN)}</li>
          {site.address && <li><a href={site.directionsUrl} target="_blank" rel="noopener">{site.address}</a></li>}
          {site.phone && <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>}
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        </ul>
      </div>
    </div>
    <div class="mega" aria-hidden="true">{site.name}</div>
    <div class="copy">
      <span>&copy; {year} {site.name}. All rights reserved.</span>
      <span class="credit">Site by <a href={site.credit.url} target="_blank" rel="noopener">{site.credit.name}</a></span>
    </div>
  </div>
</footer>
