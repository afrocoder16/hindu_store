---
import { site } from '../config';
import { OPEN_MIN, CLOSE_MIN, formatClock } from '../lib/hours';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">{site.name}</div>
        <p>{site.tagline}</p>
        <p class="muted" style="color:#cdb79d">Groceries &middot; Deli &middot; Dine-in &middot; Carry-out</p>
      </div>
      <div>
        <h3>Explore</h3>
        <ul>
          <li><a href="/#special">Specials</a></li>
          <li><a href="/#menu">Menu</a></li>
          <li><a href="/#story">Our story</a></li>
          <li><a href="/#visit">Visit</a></li>
          <li><button class="linkish" type="button" data-open-cart style="color:#f1e3d0">Your cart</button></li>
        </ul>
      </div>
      <div>
        <h3>Visit</h3>
        <ul>
          <li>Open daily, {formatClock(OPEN_MIN)} to {formatClock(CLOSE_MIN)}</li>
          {site.address && <li><a href={site.directionsUrl}>{site.address}</a></li>}
          {site.phone && <li><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></li>}
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>&copy; {year} {site.name}. All rights reserved.</span>
      <span class="credit">Site by <a href={site.credit.url} target="_blank" rel="noopener">{site.credit.name}</a></span>
    </div>
  </div>
</footer>
