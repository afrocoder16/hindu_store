---
import { site } from '../config';
import { OPEN_MIN, CLOSE_MIN, formatClock } from '../lib/hours';

const links = [
  { href: '/#special', label: 'Specials' },
  { href: '/#menu', label: 'Menu' },
  { href: '/#story', label: 'Our story' },
  { href: '/#visit', label: 'Visit' },
];
const hoursText = `${formatClock(OPEN_MIN)} to ${formatClock(CLOSE_MIN)}`;
---

<div class="topbar">
  <div class="wrap">
    <div class="topbar-info">
      <span class="status" data-status data-open="false">Hours: daily {hoursText}</span>
      <span>{site.address}</span>
    </div>
    <div class="topbar-info">
      {site.phone && <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>}
      <a href="/#menu">Online ordering available</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <strong>{site.name}</strong>
      <small>Groceries &middot; Deli</small>
    </a>

    <nav id="site-nav" class="nav" aria-label="Main" data-open="false">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="btn btn-small header-cta" href="/#menu">Start an order</a>

    <button class="icon-btn" type="button" data-open-cart aria-label="Open cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z" /><path d="M6 6 5 3H2" /><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /></svg>
      <span class="badge" data-cart-count hidden>0</span>
    </button>

    <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
</header>

<script>
  import { OPEN_MIN, CLOSE_MIN, formatClock, isOpenNow } from '../lib/hours';

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const setNav = (open: boolean) => {
    nav?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setNav(nav?.getAttribute('data-open') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setNav(false);
  });

  const status = document.querySelector<HTMLElement>('[data-status]');
  if (status) {
    const open = isOpenNow();
    status.dataset.open = String(open);
    status.textContent = open ? `Open now, until ${formatClock(CLOSE_MIN)}` : `Closed now, opens ${formatClock(OPEN_MIN)}`;
  }
</script>
