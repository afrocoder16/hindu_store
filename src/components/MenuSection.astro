---
import ProductCard from './ProductCard.astro';
import { products } from '../data/products';
import { categories } from '../data/categories';

const tagline: Record<string, string> = {
  'main-dishes': 'hot plates',
  snacks: 'grab and go',
  drinks: 'cool down',
  desserts: 'sweet finish',
};
---

<section class="section" id="menu" aria-labelledby="menu-title">
  <div class="wrap">
    <div data-reveal>
      <span class="eyebrow">The menu</span>
      <h2 id="menu-title">What's <span class="script" style="color:var(--brick);font-size:1.15em;text-transform:none">cooking</span></h2>
      <p class="muted" style="max-width:34rem">Everything from our deli counter. Tap Add, and build your order. We'll text it to the kitchen for you.</p>
    </div>

    <div class="menu-tools">
      <div class="chips" role="group" aria-label="Menu categories">
        <button class="chip" type="button" data-cat="all" aria-pressed="true">All</button>
        {categories.map((c) => <button class="chip" type="button" data-cat={c.id} aria-pressed="false">{c.name}</button>)}
      </div>
      <label class="search">
        <span class="sr-only">Search the menu</span>
        <input type="search" placeholder="Search the menu" data-menu-search autocomplete="off" />
      </label>
    </div>

    <div data-menu>
      {categories.map((c) => (
        <div class="menu-group" data-group={c.id}>
          <h3>{c.name} <small>{tagline[c.id]}</small></h3>
          <div class="grid">
            {products.filter((p) => p.category === c.id).map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      ))}
    </div>

    <div class="menu-empty" data-menu-empty hidden>
      <p>No dishes match that search.</p>
      <button class="btn btn-small" type="button" data-menu-reset>Show the full menu</button>
    </div>
  </div>
</section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-cat]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  const search = document.querySelector<HTMLInputElement>('[data-menu-search]');
  const empty = document.querySelector<HTMLElement>('[data-menu-empty]');
  let category = 'all';

  function apply() {
    const q = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    groups.forEach((group) => {
      const inCategory = category === 'all' || group.dataset.group === category;
      let shown = 0;
      group.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
        const match = inCategory && (!q || (card.dataset.search ?? '').includes(q));
        card.hidden = !match;
        if (match) shown++;
      });
      group.hidden = shown === 0;
      visible += shown;
    });
    if (empty) empty.hidden = visible > 0;
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      category = chip.dataset.cat ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    }),
  );
  search?.addEventListener('input', apply);
  document.querySelector('[data-menu-reset]')?.addEventListener('click', () => {
    if (search) search.value = '';
    category = 'all';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === 'all')));
    apply();
  });
</script>
