---
import { site } from '../config';

const hasCashApp = site.cashTag.trim() !== '';
---

<div class="backdrop" data-backdrop></div>

<aside class="drawer" data-drawer role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true">
  <div class="drawer-head">
    <h2 id="drawer-title">Your order</h2>
    <button class="icon-btn" type="button" data-close-cart aria-label="Close cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <!-- Step 1: cart -->
  <section class="view" data-view="cart">
    <div class="drawer-body">
      <div class="empty" data-empty hidden style="padding-block:2rem">
        <h3>Your cart is empty</h3>
        <p class="muted">Add a few plates from the menu to get started.</p>
        <a class="btn" href="/#menu" data-close-cart>Browse the menu</a>
      </div>
      <ul class="cart-lines" data-lines></ul>
    </div>
    <div class="drawer-foot" data-cart-foot>
      <div class="sum"><div class="total"><span>Subtotal</span><span data-subtotal>$0.00</span></div></div>
      <button class="btn btn-gold btn-block btn-lg" type="button" data-go-checkout style="margin-top:0.9rem">Checkout</button>
    </div>
  </section>

  <!-- Step 2: checkout -->
  <form class="view" data-view="checkout" hidden>
    <div class="drawer-body">
      <button class="linkish" type="button" data-back-cart style="margin-bottom:1rem">&larr; Back to cart</button>
      <div class="form">
        <fieldset class="field">
          <legend>How will you get it?</legend>
          <div class="options">
            <label class="option"><input type="radio" name="fulfillment" value="Pickup" checked /><span>Pickup</span></label>
            <label class="option"><input type="radio" name="fulfillment" value="Dine-in" /><span>Dine-in</span></label>
          </div>
        </fieldset>

        <fieldset class="field">
          <legend>When?</legend>
          <div class="options">
            <label class="option"><input type="radio" name="when" value="asap" checked data-when-asap /><span>As soon as possible<small data-asap-note></small></span></label>
            <label class="option"><input type="radio" name="when" value="later" /><span>Pick a time</span></label>
          </div>
          <select name="slot" data-slot aria-label="Pickup time" hidden></select>
        </fieldset>

        <div class="field">
          <label for="co-name">Name</label>
          <input id="co-name" name="name" type="text" autocomplete="name" required maxlength="60" />
        </div>
        <div class="field">
          <label for="co-phone">Your phone</label>
          <input id="co-phone" name="phone" type="tel" autocomplete="tel" required maxlength="20" />
        </div>
        <div class="field">
          <label for="co-notes">Notes (optional)</label>
          <textarea id="co-notes" name="notes" maxlength="200" placeholder="Allergies, spice level, anything we should know"></textarea>
        </div>

        <fieldset class="field">
          <legend>Add a tip (optional)</legend>
          <div class="options">
            <label class="option"><input type="radio" name="tip" value="0" checked /><span>None</span></label>
            <label class="option"><input type="radio" name="tip" value="10" /><span>10%</span></label>
            <label class="option"><input type="radio" name="tip" value="15" /><span>15%</span></label>
            <label class="option"><input type="radio" name="tip" value="20" /><span>20%</span></label>
          </div>
        </fieldset>

        <fieldset class="field">
          <legend>How will you pay?</legend>
          <div class="options">
            <label class="option"><input type="radio" name="payment" value="counter" checked /><span>At the counter<small>Cash or card</small></span></label>
            {hasCashApp && <label class="option"><input type="radio" name="payment" value="cashapp" /><span>Cash App<small>Amount filled in for you</small></span></label>}
          </div>
        </fieldset>

        <div class="sum" data-summary>
          <div><span>Subtotal</span><span data-s-subtotal></span></div>
          <div data-tax-row hidden><span>Tax</span><span data-s-tax></span></div>
          <div data-tip-row hidden><span>Tip</span><span data-s-tip></span></div>
          <div class="total"><span>Total</span><span data-s-total></span></div>
        </div>
      </div>
    </div>
    <div class="drawer-foot">
      <button class="btn btn-gold btn-block btn-lg" type="submit" data-place>Place order</button>
      <p class="note" style="margin:0.6rem 0 0;text-align:center" data-next-note>Next, you'll send your order to us by text.</p>
    </div>
  </form>

  <!-- Step 3: send + pay -->
  <section class="view" data-view="done" hidden>
    <div class="drawer-body">
      <div class="receipt">
        <span class="eyebrow" style="margin:0 0 0.5rem">Your order number</span>
        <div class="order-no" data-order-no></div>
        <p class="note" style="margin:0.5rem 0 0" data-order-meta></p>
      </div>

      <ol class="order-steps" data-steps>
        <li data-step-text>
          <h3>Text us your order</h3>
          <p>Your order isn't placed until you send the text.</p>
          <div class="stack">
            <a class="btn btn-gold btn-block" data-sms-link href="#">Text my order to {site.smsDisplay}</a>
            <button class="btn btn-outline btn-block btn-small" type="button" data-copy-order>Copy order text</button>
          </div>
          <div class="qr" data-sms-qr-wrap hidden>
            <img data-sms-qr alt="QR code that opens a text message to the store with your order" width="160" height="160" />
            <div class="note">On a computer? Scan with your phone to text from there.</div>
          </div>
          <p class="note" data-send-status role="status" style="margin:0.6rem 0 0"></p>
        </li>
        <li data-step-pay>
          <h3 data-pay-title>Pay</h3>
          <p data-pay-line></p>
          <div class="stack" data-cash-box hidden>
            <a class="btn btn-brick btn-block" data-cash-link href="#" target="_blank" rel="noopener">Pay with Cash App</a>
            <div class="qr" data-cash-qr-wrap hidden>
              <img data-cash-qr alt="QR code that opens Cash App to pay the store" width="160" height="160" />
            </div>
            <p class="note" style="margin:0">Put <strong data-cash-note></strong> in the Cash App note so we can match your payment.</p>
          </div>
        </li>
      </ol>
    </div>
    <div class="drawer-foot">
      <button class="btn btn-block" type="button" data-close-cart>Done</button>
    </div>
  </section>
</aside>

<script>
  import '../scripts/order';
</script>
